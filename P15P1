class Employee:
    RaiseAmount = 1.04

    def __init__(self, first, last, pay, bonusrate):
        self.first = first
        self.last = last
        self.pay = pay
        self.bonusrate = bonusrate
        self.email = first + '.' + last + '@company.com'
    def fname(self):
        return '{} {}'.format(self.first, self.last)
    def RaiseApplied(self):
        self.pay = int(self.pay * self.RaiseAmount)
    def BonusFormula(self):
        return self.pay * self.bonusrate
    def TotalCompensation(self):
        return self.pay + self.BonusFormula()

class Developer(Employee):
    RaiseAmount = 1.10
    
    def __init__(self, first, last, pay, bonusrate, prolanguage):
        super().__init__(first, last, pay, bonusrate)
        self.prolanguage = prolanguage

class Manager(Employee):
    def __init__(self, first, last, pay, bonusrate, employees=None):
        super().__init__(first, last, pay, bonusrate)
        if employees is None:
            self.employees = []
        else:
            self.employees = employees
    def AddEmp(self, emp):
        if emp not in self.employees:
            self.employees.append(emp)
    def RemoveEmp(self, emp):
        if emp in self.employees:
            self.employees.remove(emp)
    def PrintEmps(self):
        for emp in self.employees:
            print('-->', emp.fname())   # FIXED HERE

